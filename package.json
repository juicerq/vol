{
  "name": "vol",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt -b firefox --mv3",
    "build": "wxt build -b firefox --mv3",
    "zip": "wxt zip -b firefox --mv3",
    "xpi": "wxt zip -b firefox --mv3 && cp .output/vol-$npm_package_version-firefox.zip .output/vol.xpi",
    "check": "wxt prepare && svelte-check --tsconfig ./tsconfig.json",
    "lint": "oxlint src",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@wxt-dev/module-svelte": "^2.0.5",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "5.9.3",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
